{
  "name": "@traceai/sdk",
  "version": "0.1.0",
  "description": "Non-blocking, privacy-first telemetry for asynchronous AI operations",
  "private": false,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
