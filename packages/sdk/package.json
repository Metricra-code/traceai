{
  "name": "@traceai/sdk",
  "version": "0.1.0",
  "description": "Non-blocking, privacy-first telemetry for asynchronous AI operations",
  "private": false,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Metricra-code/traceai.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/Metricra-code/traceai/blob/main/docs/sdk.md",
  "bugs": {
    "url": "https://github.com/Metricra-code/traceai/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup --config tsup.config.ts"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@traceai/shared": "workspace:*"
  }
}
