{
  "name": "traceai",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=22",
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"bun run --filter @traceai/api dev\" \"bun run --filter @traceai/web dev\"",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && bun run --filter @akai_80percent/traceai-sdk typecheck && bun run --filter \"@traceai/*\" typecheck",
    "test": "vitest run",
    "test:integration": "bun run --filter @traceai/api test:integration",
    "test:e2e": "playwright test",
    "test:e2e:workers": "TRACEAI_E2E_WORKERS=1 playwright test",
    "verify:deployment": "bun scripts/verify-deployment.ts",
    "benchmark:api": "bun scripts/benchmark-api.ts",
    "benchmark:dashboard": "bun scripts/benchmark-dashboard.ts",
    "benchmark:sustained": "bun scripts/benchmark-sustained.ts",
    "test:packages": "bun scripts/verify-packages.ts",
    "build": "bun run --filter @akai_80percent/traceai-sdk build && bun run --filter \"@traceai/*\" build",
    "db:migrate": "bun run --filter @traceai/api db:migrate",
    "db:pricing": "bun scripts/import-pricing.ts",
    "db:seed": "bun packages/database/src/seed.ts && bun scripts/seed-local.ts",
    "demo:node": "bun examples/node-demo/src/index.ts",
    "demo:gemini": "bun examples/gemini-demo/src/index.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "10.0.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@playwright/test": "^1.55.0",
    "@traceai/shared": "workspace:*",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "4.1.11",
    "concurrently": "^9.2.0",
    "eslint": "10.12.0",
    "prettier": "^3.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "4.1.11",
    "zod": "4.6.5"
  },
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples/*"
  ],
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "workerd"
  ]
}
