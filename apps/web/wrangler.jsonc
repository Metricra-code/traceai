{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "traceai-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets",
  },
  "services": [
    {
      "binding": "TRACEAI_API",
      "service": "traceai-api",
    },
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "traceai-web",
    },
  ],
}
