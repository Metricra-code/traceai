# Local web connects through its same-origin proxy to the Worker.
TRACEAI_API_URL=http://127.0.0.1:8787
# Node example only; NEVER prefix ingestion keys with NEXT_PUBLIC_.
TRACEAI_API_KEY=
TRACEAI_ENDPOINT=http://127.0.0.1:8787

# Optional server-side real Gemini example. Never use NEXT_PUBLIC_ for either key.
# Put your values in the ignored .env.local, not this tracked template.
GEMINI_API_KEY=
# Select a model available to your own Free Tier project in Google AI Studio.
GEMINI_MODEL=
# Set to 1 only after personally confirming the project uses Free Tier, not paid billing.
# This is an explicit attestation, not a programmatic verification of billing status.
GEMINI_FREE_TIER_CONFIRMED=0
